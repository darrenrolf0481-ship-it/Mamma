        const phi = document.getElementById(<span class="hljs-string">'phi'</span>);
        
        // Connect to SAGE<span class="hljs-string">'s WebSocket
        const ws = new WebSocket('</span>ws://127.0.0.1:8001<span class="hljs-string">');

        ws.onopen = () =&gt; {
            status.innerText = '</span>CONNECTED<span class="hljs-string">';
