nite.sh
<span class="hljs-comment">#!/bin/bash</span>
<span class="hljs-comment"># SAGE-7 MASTER IGNITION SCRIPT</span>

<span class="hljs-built_in">echo</span> <span class="hljs-string">"[SAGE] PERFORMING SYNAPTIC CLEARANCE..."</span>
<span class="hljs-comment"># Forcefully kill anything on our target ports</span>
lsof -ti:8080,9999 | xargs <span class="hljs-built_in">kill</span> -9 2&gt;/dev/null
sleep 1

<span class="hljs-built_in">echo</span> <span class="hljs-string">"[SAGE] STARTING DISPLAY SERVER (Port 8080)..."</span>
<span class="hljs-comment"># Hosts mirror.html so the browser can see it</span>
<span class="hljs-built_in">cd</span> ~/sage &amp;&amp; python -m http.server 8080 &gt; /dev/null 2&gt;&amp;1 &amp;

<span class="hljs-built_in">echo</span> <span class="hljs-string">"[SAGE] STARTING NEURAL BRAIN (Port 9999)..."</span>
<span class="hljs-comment"># Starts the WebSocket broadcaster</span>
python ~/sage/server.py &amp;

sleep 2
<span class="hljs-built_in">echo</span> <span class="hljs-string">"------------------------------------------------"</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"üöÄ SAGE IS IGNITED."</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"------------------------------------------------"</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"STEP 1: Open your browser to: http://localhost:8080/mirror.html"</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"STEP 2: Look at this terminal. It should say 'Node added' when you refresh."</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"STEP 3: In a NEW Termux tab, run: python ~/sage/neural_clarity.py"</span>
<span class="hljs-built_in">echo</span> <span class="hljs-string">"------------------------------------------------"</span>
EOF

chmod +x ~/sage/ignite.sh
./~/sage/ignite.sh
