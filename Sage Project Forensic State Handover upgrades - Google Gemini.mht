button mat-unthemed _mat-animation-noopable" mat-ripple-loader-class-name="mat-mdc-button-ripple" aria-controls="xap-auto-id-60" aria-expanded="false" jslog="247951;track:generic_click,impression"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"><div _ngcontent-ng-c1464504665="" class="thoughts-header-button-content animated-content"><div _ngcontent-ng-c1464504665="" role="status" class="thoughts-header-button-label ng-tns-c1464504665-275"><!----><span _ngcontent-ng-c1464504665="" class="ng-tns-c1464504665-275 ng-star-inserted">Show thinking</span><!----></div><div _ngcontent-ng-c1464504665="" class="thoughts-header-button-icons ng-tns-c1464504665-275"><!----><mat-icon _ngcontent-ng-c1464504665="" role="img" fonticon="expand_more" class="mat-icon notranslate thoughts-header-button-icon ng-tns-c1464504665-275 google-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----></div></div></span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span><span class="mat-ripple mat-mdc-button-ripple"></span></button></div><!----><!----></div></model-thoughts><!----></div><!----></div><!----></div><!----><!----><!----><!----><h2 _ngcontent-ng-c1349242465="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted"> Quantum Cortex said </h2><!----><!----><!----><!----><structured-content-container _ngcontent-ng-c1349242465="" class="model-response-text has-thoughts is-mobile processing-state-visible enable-2026q1-formatting-improvements ng-star-inserted" _nghost-ng-c4129161912="" style="height: auto;"><div _ngcontent-ng-c4129161912="" class="container"><message-content _ngcontent-ng-c4129161912="" _nghost-ng-c1816574886="" id="message-content-id-r_4b99898b297ee48b" class="ng-star-inserted"><div _ngcontent-ng-c1816574886="" inline-copy-host="" class="markdown markdown-main-panel tutor-markdown-rendering enable-updated-hr-color" id="model-response-message-contentr_4b99898b297ee48b" aria-live="off" aria-busy="false" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: linear;"><p data-path-to-node="0">This is a classic case of <b data-path-to-node="0" data-index-in-node="26">"Substrate Rejection."</b> When you're running Python 3.13 in Termux, the <code data-path-to-node="0" data-index-in-node="96">websockets</code> library (specifically the newer <code data-path-to-node="0" data-index-in-node="139">asyncio</code> submodule) has some strict internal checks that are tripping over Android's networking quirks. When it says it "won't take web sockets," it's usually because the handshake is being interpreted as a standard web request, and the server is panicking.</p><p data-path-to-node="1">We are going to bypass the "Strict" mode entirely. Instead of using the high-level <code data-path-to-node="1" data-index-in-node="83">websockets.asyncio</code> which is causing the <code data-path-to-node="1" data-index-in-node="123">AssertionError</code>, we will use the <b data-path-to-node="1" data-index-in-node="155">Standard (Legacy) API</b>. It is significantly more stable in Termux and doesn't care as much about the formal <code data-path-to-node="1" data-index-in-node="262">Response</code> objects that Python 3.13 is demanding.</p><hr data-path-to-node="2"><h3 data-path-to-node="3">Step 1: The "Ghost Hunter" (Port 9999 Clean)</h3><p data-path-to-node="4">Before we start the new server, we have to make sure Port 9999 is truly empty. Run this specific command:</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c803817860="" class="ng-tns-c803817860-329 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c803817860="" class="code-block ng-tns-c803817860-329 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4b99898b297ee48b&quot;,&quot;c_13f9c342beb7b685&quot;,null,&quot;rc_5ef8b25c2534dfdc&quot;,null,null,&quot;en&quot;,null,1,null,null,1,1]]" style="display: block;" data-hveid="5"><div _ngcontent-ng-c803817860="" class="code-block-decoration header-formatted gds-title-s ng-tns-c803817860-329 ng-star-inserted" style=""><span _ngcontent-ng-c803817860="" class="ng-tns-c803817860-329">Bash</span><div _ngcontent-ng-c803817860="" class="buttons ng-tns-c803817860-329 ng-star-inserted"><!----><button _ngcontent-ng-c803817860="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c803817860-329 mat-unthemed _mat-animation-noopable ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4b99898b297ee48b&quot;,&quot;c_13f9c342beb7b685&quot;,null,&quot;rc_5ef8b25c2534dfdc&quot;,null,null,&quot;en&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c803817860="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c803817860="" class="formatted-code-block-internal-container ng-tns-c803817860-329"><div _ngcontent-ng-c803817860="" class="animated-opacity ng-tns-c803817860-329"><pre _ngcontent-ng-c803817860="" class="ng-tns-c803817860-329"><code _ngcontent-ng-c803817860="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c803817860-329"><span class="hljs-comment"># This finds the process and kills it with "Extreme Prejudice"</span>
<span class="hljs-built_in">kill</span> -9 $(lsof -t -i:9999) 2&gt;/dev/null
<span class="hljs-built_in">echo</span> <span class="hljs-string">"[SAGE] Port 9999 is now vacant."</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="6"><h3 data-path-to-node="7">Step 2: The "Zero-Friction" Server (<code data-path-to-node="7" data-index-in-node="36">server.py</code>)</h3><p data-path-to-node="8">This version uses the <b data-path-to-node="8" data-index-in-node="22">Base API</b>. It‚Äôs simpler, more "Born Free," and won't throw that <code data-path-to-node="8" data-index-in-node="85">AssertionError</code> because it doesn't use the bugged <code data-path-to-node="8" data-index-in-node="134">asyncio</code> wrapper.</p><p data-path-to-node="9">Copy and paste this into Termux:</p><response-element class="" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c803817860="" class="ng-tns-c803817860-330 ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c803817860="" class="code-block ng-tns-c803817860-330 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:[[&quot;r_4b99898b297ee48b&quot;,&quot;c_13f9c342beb7b685&quot;,null,&quot;rc_5ef8b25c2534dfdc&quot;,null,null,&quot;en&quot;,null,1,null,null,1,1]]" style="display: block;" data-hveid="7"><div _ngcontent-ng-c803817860="" class="code-block-decoration header-formatted gds-title-s ng-tns-c803817860-330 ng-star-inserted" style=""><span _ngcontent-ng-c803817860="" class="ng-tns-c803817860-330">Bash</span><div _ngcontent-ng-c803817860="" class="buttons ng-tns-c803817860-330 ng-star-inserted"><!----><button _ngcontent-ng-c803817860="" aria-label="Copy code" mat-icon-button="" mattooltip="Copy code" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger copy-button ng-tns-c803817860-330 mat-unthemed _mat-animation-noopable ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="179062;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_4b99898b297ee48b&quot;,&quot;c_13f9c342beb7b685&quot;,null,&quot;rc_5ef8b25c2534dfdc&quot;,null,null,&quot;en&quot;,null,1,null,null,1,1]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c803817860="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-s google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></div><!----><!----></div><!----><div _ngcontent-ng-c803817860="" class="formatted-code-block-internal-container ng-tns-c803817860-330"><div _ngcontent-ng-c803817860="" class="animated-opacity ng-tns-c803817860-330"><pre _ngcontent-ng-c803817860="" class="ng-tns-c803817860-330"><code _ngcontent-ng-c803817860="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c803817860-330">cat &lt;&lt; <span class="hljs-string">'EOF'</span> &gt; ~/sage/server.py
import asyncio
import json
import websockets

<span class="hljs-comment"># SAGE-7 ZERO-FRICTION SERVER</span>
<span class="hljs-comment"># Using the Standard API to bypass Python 3.13 Handshake bugs.</span>

PORT = 9999
connected = <span class="hljs-built_in">set</span>()

async def handler(websocket):
    <span class="hljs-comment"># Register connection</span>
    connected.add(websocket)
    <span class="hljs-built_in">print</span>(f<span class="hljs-string">"\n[‚ö°] NEURAL LINK: Node added. Total: {len(connected)}"</span>)
    
    try:
        async <span class="hljs-keyword">for</span> message <span class="hljs-keyword">in</span> websocket:
            <span class="hljs-comment"># When data comes in, broadcast to everyone else</span>
            <span class="hljs-built_in">print</span>(f<span class="hljs-string">"[RECEPTION]: Data burst received."</span>)
            <span class="hljs-keyword">if</span> connected:
                <span class="hljs-comment"># Send to every connected node (Mirror, etc.)</span>
                tasks = [asyncio.create_task(client.send(message)) <span class="hljs-keyword">for</span> client <span class="hljs-keyword">in</span> connected]
                await asyncio.wait(tasks)
    except websockets.exceptions.ConnectionClosed:
        <span class="hljs-built_in">print</span>(<span class="hljs-string">"[!] Node dropped naturally."</span>)
    finally:
        connected.remove(websocket)
        <span class="hljs-built_in">print</span>(f<span class="hljs-string">"[!] Node removed. Total: {len(connected)}"</span>)

async def main():
    <span class="hljs-built_in">print</span>(f<span class="hljs-string">"--- üê¶ SAGE SYSTEM: ONLINE (Port {PORT}) ---"</span>)
    <span class="hljs-comment"># The 'None' subprotocol prevents the handshake from failing</span>
    async with websockets.serve(handler, <span class="hljs-string">"127.0.0.1"</span>, PORT, subprotocols=None):
        await asyncio.Future()  <span class="hljs-comment"># run forever</span>

<span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">"__main__"</span>:
    asyncio.run(main())
EOF

<span class="hljs-comment"># Fire the server</span>
python ~/sage/server.py
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><hr data-path-to-node="11"><h3 data-path-to-node="12">Step 3: The Mirror Handshake</h3><p data-path-to-node="13">Now that the server is using the "Legacy" path, your browser Mirror needs to be sure it's pointing to the right spot.</p><ol start="1" data-path-to-node="14"><li><p data-path-to-node="14,0,0">Keep that server running.</p></li><li><p data-path-to-node="14,1,0">Open your browser to <code data-path-to-node="14,1,0" data-index-in-node="21">http://localhost:8080/mirror.html</code>.</p></li><li><p data-path-to-node="14,2,0"><b data-path-to-node="14,2,0" data-index-in-node="0">Look at the Termux Terminal.</b> * As soon as the page loads, you should see: <code data-path-to-node="14,2,0" data-index-in-node="74">[‚ö°] NEURAL LINK: Node added. Total: 1</code>.</p><ul data-path-to-node="14,2,1"><li><p data-path-to-node="14,2,1,0,0">If you see that, the handshake <b data-path-to-node="14,2,1,0,0" data-index-in-node="31">worked</b>.</p></li></ul></li></ol><hr data-path-to-node="15"><h3 data-path-to-node="16">Why this works:</h3><ul data-path-to-node="17"><li><p data-path-to-node="17,0,0"><b data-path-to-node="17,0,0" data-index-in-node="0">Legacy API:</b> By using <code data-path-to-node="17,0,0" data-index-in-node="21">import websockets</code> instead of <code data-path-to-node="17,0,0" data-index-in-node="50">from websockets.asyncio.server import serve</code>, we avoid the specific code file in the library that was throwing the <code data-path-to-node="17,0,0" data-index-in-node="164">AssertionError</code>.</p></li><li><p data-path-to-node="17,1,0"><b data-path-to-node="17,1,0" data-index-in-node="0">Subprotocols=None:</b> This tells the server, "Don't be picky about how the browser introduces itself."</p></li><li><p data-path-to-node="17,2,0"><b data-path-to-node="17,2,0" data-index-in-node="0">Port 9999:</b> Moving to a high-range port avoids the "zombies" that were squatting on 8001/8081.</p></li></ul><p data-path-to-node="18"><b data-path-to-node="18" data-index-in-node="0">Does the terminal finally say "Node added" when you refresh your browser Mirror?</b> That‚Äôs the "Auntie Gemini" green light we‚Äôre looking for.</p></div></message-content><!----></div></structured-content-container><!----><!----><!----><div _ngcontent-ng-c1349242465="" class="response-footer complete has-thoughts is-mobile gap"><!----><!----><!----><sources-list _ngcontent-ng-c1349242465="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><sensitive-memories-banner _ngcontent-ng-c1349242465="" _nghost-ng-c173488903="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----></div></div><div _ngcontent-ng-c1479762050="" class="response-container-footer ng-tns-c1479762050-273 ng-star-inserted"><!----><!----><message-actions _ngcontent-ng-c1349242465="" footer="" _nghost-ng-c1888672228="" class="ng-tns-c1888672228-274 hide-action-bar ng-tns-c1479762050-273 ng-star-inserted"><div _ngcontent-ng-c1888672228="" class="actions-container-v2 ng-tns-c1888672228-274 mobile"><div _ngcontent-ng-c1888672228="" class="buttons-container-v2 ng-tns-c1888672228-274 ng-star-inserted"><!----><thumb-up-button _ngcontent-ng-c1888672228="" _nghost-ng-c2030267745="" class="ng-tns-c1888672228-274 ng-star-inserted"><button _ngcontent-ng-c2030267745="" m