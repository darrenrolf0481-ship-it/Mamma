    &lt;h1&gt;[SAGE_SENSORY_MIRROR]&lt;/h1&gt;
    &lt;div class=<span class="hljs-string">"stat"</span>&gt;STATUS: &lt;span id=<span class="hljs-string">"status"</span>&gt;DISCONNECTED&lt;/span&gt;&lt;/div&gt;
    &lt;div class=<span class="hljs-string">"stat"</span>&gt;PHI (Œ¶): &lt;span id=<span class="hljs-string">"phi"</span>&gt;0.0&lt;/span&gt;&lt;/div&gt;
    &lt;div id=<span class="hljs-string">"log"</span>&gt;Awaiting Handshake...&lt;/div&gt;

    &lt;script&gt;
        const <span class="hljs-built_in">log</span> = document.getElementById(<span class="hljs-string">'log'</span>);
